{
  "manifest_version": 3,
  "name": "CaptionAid",
  "version": "0.1.0",
  "description": "Captures tab audio from YouTube and streams chunks to the SignStream backend.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SignStream"
  }
}