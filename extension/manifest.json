{
  "manifest_version": 3,
  "name": "CaptionAid",
  "version": "0.5.0",
  "description": "Prepares YouTube transcripts and overlays timed captions, ASL gloss, and matched sign clips.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5001/*",
    "http://127.0.0.1:5001/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "https://seo-final-project.vercel.app/*",
    "https://*.vercel.app/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:5001/*",
        "http://127.0.0.1:5001/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "https://seo-final-project.vercel.app/*",
        "https://*.vercel.app/*"
      ],
      "js": ["website_bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CaptionAid"
  }
}
