AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Vercel container deployments can use these aliases for the same AWS values.
# Local development should continue using the standard names above.
# CAPTION_AWS_ACCESS_KEY_ID=
# CAPTION_AWS_SECRET_ACCESS_KEY=

ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=

# Production uses S3 for durable job/caption state. Dockerfile.vercel sets this
# automatically; local development should keep the default SQLite behavior.
# CAPTION_STORE=s3
