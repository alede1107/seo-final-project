FROM node:22-bookworm-slim AS frontend-build

WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
# npm ci can omit Rolldown's Linux native optional binding when the lockfile
# was generated on Windows. npm install still honors the lockfile while
# resolving the binding for the container's actual platform.
RUN npm install --include=optional --no-audit --no-fund
COPY frontend/ ./
RUN npm run build


FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CAPTION_STORE=s3 \
    CAPTION_DB_PATH=/tmp/captionaid/captions.db

# yt-dlp needs a supported JavaScript runtime for reliable YouTube extraction.
COPY --from=frontend-build /usr/local/bin/node /usr/local/bin/node

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py word_to_url.json ./
COPY backend/ ./backend/
COPY services/ ./services/
COPY --from=frontend-build /build/frontend/dist ./frontend/dist/

RUN mkdir -p /tmp/captionaid && \
    useradd --create-home --uid 10001 captionaid && \
    chown -R captionaid:captionaid /tmp/captionaid

USER captionaid

CMD ["sh", "-c", "gunicorn --bind 0.0.0.0:${PORT:-8080} --workers 1 --threads 8 --timeout 300 --access-logfile - backend.app:app"]
